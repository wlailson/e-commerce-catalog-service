# Local Docker Compose development settings.
# Replace the JWT secret before running anywhere except a disposable local environment:
# openssl rand -hex 32
IMAGE_NAME=e-commerce-catalog-service
IMAGE_TAG=local

APP_PROFILE=dev
PORT=8081

POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=change-me-local-only

JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080